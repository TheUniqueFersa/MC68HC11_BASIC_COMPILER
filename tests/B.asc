; PROGRAMA CORRECTO: RECEPCIÓN SERIAL A BUFFER
; MCU: 68HC11

;--------------------------------------
; CONSTANTES Y REGISTROS
;--------------------------------------

SCDR      EQU   $102F
SCSR      EQU   $102E
SCCR2     EQU   $102D
SCCR1     EQU   $102C
BAUD      EQU   $102B
DDRD      EQU   $1009

LIMITE_OK EQU   $05          ; 5 caracteres
DIR_BASE  EQU   $0030        ; buffer en RAM

; Variables en RAM (solo EQU)
ORDEN     EQU   $0000        ; último carácter recibido
CONTADOR  EQU   $0001        ; cuántos caracteres llevamos

;--------------------------------------
; CÓDIGO PRINCIPAL
;--------------------------------------

        ORG   $8000

INICIO
        LDS   #$00FF         ; (inmediato, inherente)

        JSR   SERIAL         ; configura SCI

        CLR   CONTADOR       ; (directo + inherente)

        LDX   #DIR_BASE      ; X apunta al buffer (inmediato)

BUCLE
        ; (aquí, en un sistema real, se esperaría a que haya dato en SCSR.
        ; para simplificar, solo leemos SCDR directamente.)

        LDAA  SCDR           ; (extendido) leer un carácter
        STAA  ORDEN          ; (directo) guardar último carácter
        STAA  0,X            ; (indexado) guardar en buffer
        INX                  ; (inherente) avanzar puntero

        INC   CONTADOR       ; (directo + inherente)

        LDAA  CONTADOR       ; (directo)
        CMPA  #LIMITE_OK     ; (inmediato)
        BEQ   FIN_OK         ; (relativo) si ya recibimos 5, salir

        LDAA  ORDEN          ; (directo)
        CMPA  #'X'           ; (inmediato) si el último carácter es 'X'
        BEQ   FIN_OK         ; (relativo) también terminamos

        BRA   BUCLE          ; (relativo)

FIN_OK
        NOP                  ; (inherente)
        BRA   FIN_OK         ; lazo infinito final

;--------------------------------------
; SUBRUTINA DE CONFIGURACIÓN SERIAL
;--------------------------------------

SERIAL
        LDD   #$302C         ; (inmediato) configuración SCI
        STAA  BAUD           ; (extendido)
        STAB  SCCR2          ; (extendido)

        LDAA  #$00           ; (inmediato)
        STAA  SCCR1          ; (extendido)

        LDAA  #$FE           ; (inmediato)
        STAA  DDRD           ; (extendido)

        RTS                  ; (inherente)

;--------------------------------------
; VECTOR DE RESET
;--------------------------------------

        ORG   $FFFE

RESET
        FCB   $80,$00        ; vector de reset → $8000 (INICIO)

        END   $8000
