   1:      () : ; PROGRAMA CORRECTO: RECEPCIÓN SERIAL A BUFFER
   2:      () : ; MCU: 68HC11
   3:      () : 
   4:      () : ;--------------------------------------
   5:      () : ; CONSTANTES Y REGISTROS
   6:      () : ;--------------------------------------
   7:      () : 
   8:      () : SCDR      EQU   $102F
   9:      () : SCSR      EQU   $102E
  10:      () : SCCR2     EQU   $102D
  11:      () : SCCR1     EQU   $102C
  12:      () : BAUD      EQU   $102B
  13:      () : DDRD      EQU   $1009
  14:      () : 
  15:      () : LIMITE_OK EQU   $05          ; 5 caracteres
  16:      () : DIR_BASE  EQU   $0030        ; buffer en RAM
  17:      () : 
  18:      () : ; Variables en RAM (solo EQU)
  19:      () : ORDEN     EQU   $0000        ; último carácter recibido
  20:      () : CONTADOR  EQU   $0001        ; cuántos caracteres llevamos
  21:      () : 
  22:      () : ;--------------------------------------
  23:      () : ; CÓDIGO PRINCIPAL
  24:      () : ;--------------------------------------
  25:      () : 
  26: 8000 () :         ORG   $8000
  27: 8000 () : 
  28: 8000 () : INICIO
  29: 8000 (8E 00 FF) :         LDS   #$00FF         ; (inmediato, inherente)
  30: 8003 () : 
  31: 8003 (BD 80 2B) :         JSR   SERIAL         ; configura SCI
  32: 8006 () : 
  33: 8006 (7F 00 01) :         CLR   CONTADOR       ; (directo + inherente)
  34: 8009 () : 
  35: 8009 (CE 00 30) :         LDX   #DIR_BASE      ; X apunta al buffer (inmediato)
  36: 800C () : 
  37: 800C () : BUCLE
  38: 800C () :         ; (aquí, en un sistema real, se esperaría a que haya dato en SCSR.
  39: 800C () :         ; para simplificar, solo leemos SCDR directamente.)
  40: 800C () : 
  41: 800C (B6 10 2F) :         LDAA  SCDR           ; (extendido) leer un carácter
  42: 800F (B7 00 00) :         STAA  ORDEN          ; (directo) guardar último carácter
  43: 8012 (97 00) :         STAA  0,X            ; (indexado) guardar en buffer
  44: 8014 (08) :         INX                  ; (inherente) avanzar puntero
  45: 8015 () : 
  46: 8015 (7C 00 01) :         INC   CONTADOR       ; (directo + inherente)
  47: 8018 () : 
  48: 8018 (B6 00 01) :         LDAA  CONTADOR       ; (directo)
  49: 801B (81 05) :         CMPA  #LIMITE_OK     ; (inmediato)
  50: 801D (27 09) :         BEQ   FIN_OK         ; (relativo) si ya recibimos 5, salir
  51: 801F () : 
  52: 801F (B6 00 00) :         LDAA  ORDEN          ; (directo)
  53: 8022 (81 58) :         CMPA  #'X'           ; (inmediato) si el último carácter es 'X'
  54: 8024 (27 02) :         BEQ   FIN_OK         ; (relativo) también terminamos
  55: 8026 () : 
  56: 8026 (20 E4) :         BRA   BUCLE          ; (relativo)
  57: 8028 () : 
  58: 8028 () : FIN_OK
  59: 8028 (01) :         NOP                  ; (inherente)
  60: 8029 (20 FD) :         BRA   FIN_OK         ; lazo infinito final
  61: 802B () : 
  62: 802B () : ;--------------------------------------
  63: 802B () : ; SUBRUTINA DE CONFIGURACIÓN SERIAL
  64: 802B () : ;--------------------------------------
  65: 802B () : 
  66: 802B () : SERIAL
  67: 802B (CC 30 2C) :         LDD   #$302C         ; (inmediato) configuración SCI
  68: 802E (B7 10 2B) :         STAA  BAUD           ; (extendido)
  69: 8031 (F7 10 2D) :         STAB  SCCR2          ; (extendido)
  70: 8034 () : 
  71: 8034 (86 00) :         LDAA  #$00           ; (inmediato)
  72: 8036 (B7 10 2C) :         STAA  SCCR1          ; (extendido)
  73: 8039 () : 
  74: 8039 (86 FE) :         LDAA  #$FE           ; (inmediato)
  75: 803B (B7 10 09) :         STAA  DDRD           ; (extendido)
  76: 803E () : 
  77: 803E (39) :         RTS                  ; (inherente)
  78: 803F () : 
  79: 803F () : ;--------------------------------------
  80: 803F () : ; VECTOR DE RESET
  81: 803F () : ;--------------------------------------
  82: 803F () : 
  83: FFFE () :         ORG   $FFFE
  84: FFFE () : 
  85: FFFE () : RESET
  86: FFFE (80 00) :         FCB   $80,$00        ; vector de reset → $8000 (INICIO)
  87: 0000 () : 
  88: 0000 () :         END   $8000
